# Base de données (SQLite en local; mettez une URL PostgreSQL en production)
DATABASE_URL="file:./dev.db"

# Mot de passe du dashboard admin (/admin)
ADMIN_PASSWORD="changez-moi"

# Clé secrète pour signer la session admin (chaîne aléatoire longue)
AUTH_SECRET="remplacez-par-une-longue-chaine-aleatoire"

# URL publique du site (SEO : canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="https://www.votre-domaine.ma"

# Code de vérification Google Search Console (facultatif)
GOOGLE_SITE_VERIFICATION=""
